<template>
	<view class="page">
		<top-bar
			:drone-name="droneName"
			:flight-status="flightStatus"
			:flight-time="flightTime"
			:signal-strength="signalStrength"
			:satellites="satellites"
			:link-quality="linkQuality"
		/>

		<view class="nav">
			<view class="nav-btn" @tap="goDevices"><text class="nav-text">设备</text></view>
			<view class="nav-btn" @tap="goVideo"><text class="nav-text">视频</text></view>
			<view class="nav-btn" @tap="goControl"><text class="nav-text">控制</text></view>
			<view class="nav-btn" @tap="goDiagnostics"><text class="nav-text">诊断</text></view>
			<view class="nav-btn" @tap="goAbout"><text class="nav-text">关于</text></view>
		</view>

		<view class="main">
			<view v-if="connected" class="left">
				<status-panel
					:lat="lat"
					:lng="lng"
					:altitude="altitude"
					:h-speed="hSpeed"
					:v-speed="vSpeed"
					:distance="distance"
					:flight-mode="flightMode"
					:imu-ok="imuOk"
					:compass-ok="compassOk"
					:battery="battery"
					:voltage="voltage"
					:remaining-time="remainingTime"
				/>
			</view>

			<video-overlay
				:status="videoStatus"
				:resolution="resolution"
				:fps="fps"
				:is-recording="isRecording"
				@track-rect="onTrackRect"
			/>

			<view class="right">
				<bluetooth-panel
					:connected="connected"
					:device-name="deviceName"
					:device-mac="deviceMac"
					:scanning="scanning"
					:error="btError"
					@toggle="onBtToggle"
				/>
				<view v-if="connected" class="sticks">
					<text class="sticks-title">模拟摇杆</text>
					<joystick label="油门/偏航" channel-a="油门" channel-b="偏航" @change="onLeftStick" />
					<joystick label="俯仰/横滚" channel-a="俯仰" channel-b="横滚" @change="onRightStick" />
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	// 说明：真实链路（USB 视频 / USB 遥测 / BLE）尚未接入，
