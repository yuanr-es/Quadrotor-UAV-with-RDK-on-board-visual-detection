	const connected = ref(false)
	const droneName = ref('未连接设备')
	const flightStatus = ref('disconnected')
	const flightTime = ref('00:00:00')
	const signalStrength = ref('--')
	const satellites = ref('--')
	const linkQuality = ref('--')

	const videoStatus = ref('absent')
	const resolution = ref('--')
	const fps = ref('--')
	const isRecording = ref(false)

	const lat = ref('--')
	const lng = ref('--')
	const altitude = ref('--')
	const hSpeed = ref('--')
	const vSpeed = ref('--')
	const distance = ref('--')
	const flightMode = ref('--')
	const imuOk = ref(false)
	const compassOk = ref(false)
	const battery = ref(0)
	const voltage = ref('--')
	const remainingTime = ref('--')

	const deviceName = ref('')
	const deviceMac = ref('')
	const scanning = ref(false)
	const btError = ref('')

	onLoad(() => {
		console.log('index onLoad')
	})

	const goDevices = () => uni.navigateTo({ url: '/pages/devices/devices' })
	const goVideo = () => uni.navigateTo({ url: '/pages/video/video' })
	const goControl = () => uni.navigateTo({ url: '/pages/control/control' })
	const goDiagnostics = () => uni.navigateTo({ url: '/pages/diagnostics/diagnostics' })
	const goAbout = () => uni.navigateTo({ url: '/pages/about/about' })

	const onBtToggle = () => {
		uni.showToast({ title: 'BLE 控制链路待接入（§8）', icon: 'none' })
	}

	const onLeftStick = (pos: any) => {
		console.log('left stick', pos)
	}
	const onRightStick = (pos: any) => {
		console.log('right stick', pos)
	}

	const onTrackRect = (rect: any) => {
		console.log('track rect', rect)
		uni.showToast({ title: '框选已记录，控制链路待接入', icon: 'none' })
	}
</script>

