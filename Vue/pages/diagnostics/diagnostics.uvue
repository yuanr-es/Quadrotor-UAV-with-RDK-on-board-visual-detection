<template>
	<view class="dg-page">
		<view class="dg-section">
			<text class="dg-title">运行环境</text>
			<view class="dg-row"><text class="dg-k">平台</text><text class="dg-v">{{ platform }}</text></view>
			<view class="dg-row"><text class="dg-k">机型</text><text class="dg-v">{{ model }}</text></view>
			<view class="dg-row"><text class="dg-k">系统</text><text class="dg-v">{{ system }}</text></view>
			<view class="dg-row"><text class="dg-k">App 版本</text><text class="dg-v">{{ appVersion }}</text></view>
		</view>

		<view class="dg-section">
			<text class="dg-title">链路计数</text>
			<view class="dg-row"><text class="dg-k">USB 视频</text><text class="dg-v">--</text></view>
			<view class="dg-row"><text class="dg-k">USB 遥测</text><text class="dg-v">--</text></view>
			<view class="dg-row"><text class="dg-k">BLE 控制</text><text class="dg-v">--</text></view>
			<view class="dg-row"><text class="dg-k">解析错误</text><text class="dg-v">--</text></view>
			<view class="dg-row"><text class="dg-k">丢帧</text><text class="dg-v">--</text></view>
		</view>

		<view class="dg-section">
			<text class="dg-title">日志</text>
			<text class="dg-empty">日志服务待接入（services/diagnostics 的 UTS 移植）</text>
			<view class="dg-btn" @tap="exportLog"><text class="dg-btn-text">导出 / 复制</text></view>
		</view>
	</view>
</template>

<script setup lang="uts">
	const platform = ref('--')
	const model = ref('--')
	const system = ref('--')
	const appVersion = ref('1.0.0')

	onLoad(() => {
		const info = uni.getSystemInfoSync()
		platform.value = info.platform
		model.value = info.model
		system.value = info.system
	})

	const exportLog = () => {
		uni.showToast({ title: '日志服务待接入', icon: 'none' })
	}
</script>

